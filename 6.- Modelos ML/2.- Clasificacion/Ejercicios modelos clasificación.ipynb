   "source": [
    "import pandas as pd\n",
    "\n",
    "# 1) Suppose X_train / X_test already exist from your train_test_split\n",
    "# Copy to avoid SettingWithCopyWarnings\n",
    "X_tr = X_train.copy()\n",
    "X_te = X_test.copy()\n",
    "\n",
    "# 2) Binary-encode Partner & Dependents\n",
    "binary_map = {\"Yes\": 1, \"No\": 0}\n",
    "for col in [\"Partner\", \"Dependents\"]:\n",
    "    X_tr[col] = X_tr[col].map(binary_map)\n",
    "    X_te[col] = X_te[col].map(binary_map)\n",
    "\n",
    "# 3) Ordinal-encode TenureLevel\n",
    "tenure_map = {\n",
    "    \"New\":        0,\n",
    "    \"Regular\":    1,\n",
    "    \"Loyal\":      2,\n",
    "    \"Very Loyal\": 3\n",
    "}\n",
    "X_tr[\"TenureLevel\"] = X_tr[\"TenureLevel\"].map(tenure_map)\n",
    "X_te[\"TenureLevel\"] = X_te[\"TenureLevel\"].map(tenure_map)\n",
    "\n",
    "# 4) One-hot encode StreamingMovies & PaymentMethod\n",
    "#    drop_first=True to avoid perfect multicollinearity in LR\n",
    "X_tr = pd.get_dummies(\n",
    "    X_tr,\n",
    "    columns=[\"StreamingMovies\", \"PaymentMethod\"],\n",
    "    drop_first=True\n",
    ")\n",
    "X_te = pd.get_dummies(\n",
    "    X_te,\n",
    "    columns=[\"StreamingMovies\", \"PaymentMethod\"],\n",
    "    drop_first=True\n",
    ")\n",
    "\n",
    "# 5) Align test to train (so they have identical columns)\n",
    "X_te = X_te.reindex(columns=X_tr.columns, fill_value=0)\n",
    "\n",
    "# 6) Quick check\n",
    "print(\"Training features:\", X_tr.columns.tolist())\n",
    "print(\"Test   features:\", X_te.columns.tolist())"
   ]
  },
