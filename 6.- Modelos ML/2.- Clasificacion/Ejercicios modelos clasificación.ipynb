   "source": [
    "import pandas as pd\n",
    "\n",
    "# 2.1 Identify your categorical columns\n",
    "cat_cols = train.select_dtypes(include=\"object\").columns.tolist()\n",
    "\n",
    "# 2.2 For each categorical, build a summary table\n",
    "for col in cat_cols:\n",
    "    # Crosstab of counts\n",
    "    ct = pd.crosstab(train[col], train[\"ChurnBinary\"], margins=True)\n",
    "    # Compute churn rate = churners / total\n",
    "    rate = (ct[1] / ct[\"All\"]).drop(\"All\").sort_values(ascending=False)\n",
    "    # Combine counts & rate\n",
    "    summary = pd.concat([\n",
    "        ct.drop(\"All\", axis=1),\n",
    "        rate.rename(\"churn_rate\")\n",
    "    ], axis=1)\n",
    "    \n",
    "    print(f\"\\n=== {col} ===\")\n",
    "    display(summary.head(10))   # show top-10 levels by churn rate"
   ]
  },
