    "from sklearn.ensemble import RandomForestClassifier\n",
    "from sklearn.metrics import classification_report, roc_auc_score, roc_curve\n",
    "import matplotlib.pyplot as plt\n",
    "\n",
    "# 1. Select the columns you actually want to use\n",
    "cols_to_use = [\n",
    "    \"SeniorCitizen\",\n",
    "    \"tenure\",\n",
    "    \"MonthlyCharges\",\n",
    "    # add your encoded categoricals here, e.g.:\n",
    "    \"Partner\",\n",
    "    \"Dependents\",\n",
    "    \"TenureLevel\"\n",
    "]\n",
    "\n",
    "X_train_model = X_tr[cols_to_use]\n",
    "X_test_model  = X_te[cols_to_use]\n",
    "\n",
    "# 2. Instantiate and fit the RF\n",
    "'''rf = RandomForestClassifier(\n",
    "    n_estimators=300,\n",
    "    max_depth=20,\n",
    "    class_weight=\"balanced_subsample\",\n",
    "    random_state=42,\n",
    "    n_jobs=-1\n",
    ")'''\n",
    "\n",
    "rf_clf = RandomForestClassifier(n_estimators = 500, criterion ='gini') #  criterion ='entropy' \n",
    "\n",
    "\n",
    "# 3. Predict & evaluate\n",
    "y_pred  = rf.predict(X_test_model)\n",
    "y_proba = rf.predict_proba(X_test_model)[:, 1]\n",
    "\n",
    "print(classification_report(y_test, y_pred))\n",
    "auc = roc_auc_score(y_test, y_proba)\n",
    "print(f\"Test ROC-AUC: {auc:.3f}\")\n",
    "\n",
    "# 4. (Optional) ROC curve\n",
    "fpr, tpr, _ = roc_curve(y_test, y_proba)\n",
    "plt.plot(fpr, tpr, label=f\"AUC = {auc:.3f}\")\n",
    "plt.plot([0,1], [0,1], \"--\", color=\"gray\")\n",
    "plt.xlabel(\"False Positive Rate\")\n",
    "plt.ylabel(\"True Positive Rate\")\n",
    "plt.title(\"ROC Curve — Random Forest\")\n",
    "plt.legend()\n",
    "plt.show()"
   ]
